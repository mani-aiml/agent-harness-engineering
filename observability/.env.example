# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=

# Langfuse: your own self-hosted instance, or Langfuse Cloud (same code; only these three change)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# The agent's model. For qwen3:4b on Ollama: the Anthropic-compatible endpoint, any key.
# For Claude: delete ANTHROPIC_BASE_URL, set your Anthropic key, and set MODEL = "claude-haiku-4-5" in loop.py.
ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=ollama
